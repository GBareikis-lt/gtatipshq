# --- Auto-poster (scripts/auto-post.mjs) ---

# Required for the AI rewrite step. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used to rewrite source items into original articles.
# Options (cost vs quality): claude-haiku-4-5-20251001 (cheapest),
# claude-sonnet-4-6 (recommended balance), claude-opus-4-8 (highest quality).
AUTO_POST_MODEL=claude-sonnet-4-6

# Max posts created per run.
AUTO_POST_MAX=2

# Ignore source items older than this many days.
AUTO_POST_MAX_AGE_DAYS=4

# --- Spend guard (prevents runaway bills) ---
# Hard monthly cap in USD. The auto-poster stops making API calls once the
# estimated spend for the current calendar month reaches this. Estimated from
# token usage and persisted in data/budget.json.
AUTO_POST_MONTHLY_USD=5

# IMPORTANT: this is a client-side estimate, not a hard billing limit.
# ALSO set a real spend limit in the Anthropic Console:
#   console.anthropic.com -> Settings -> Limits / Billing -> monthly spend cap.

# --- Instagram carousel AI images (scripts/ig/generate-ai-carousel.mjs) ---
# fal.ai key for AI-generated slide backgrounds (FLUX). Get one free at
# https://fal.ai/dashboard/keys  (~$0.003/image). Leave empty to use the
# built-in Vice City gradient instead.
FAL_KEY=
# Optional model overrides.
FAL_MODEL=fal-ai/flux/schnell
# Higher-quality model for hero character slides (txt2img).
FAL_HERO_MODEL=fal-ai/flux/dev
# Used for hero slides when style-seeding from your uploaded art (img2img).
FAL_IMG2IMG_MODEL=fal-ai/flux/dev/image-to-image
